void removeNewLine(char *str) {
    size_t len = strlen(str);
    if (len > 0 && str[len - 1] == '\n') {
        str[len - 1] = '\0';
    }
}

void toLowerCase(char *str, char *output) {
    int i = 0;
    while (str[i] != '\0') {
        output[i] = tolower((unsigned char)str[i]);
        i++;
    }
    output[i] = '\0';
}

