int findVehicleByIdOrName(char *inputStr) {
    int i;
    char lowerInput[50], lowerName[50];

    int inputId = 0;
    if (sscanf(inputStr, "%d", &inputId) == 1) {
        for (i = 0; i < vehicleCount; i++) {
            if (vehicleId[i] == inputId) {
                return i;
            }
        }
    }

    toLowerCase(inputStr, lowerInput);
    for (i = 0; i < vehicleCount; i++) {
        toLowerCase(vehicleName[i], lowerName);
        if (strcmp(lowerName, lowerInput) == 0 || strstr(lowerName, lowerInput) != NULL) {
            return i;
        }
    }

    return -1;
}

void addVehicle() {
    if (vehicleCount >= MAX_VEHICLES) {
        printf("\nSystem full! Cannot add more vehicles.\n");
        return;
    }

    int newId, i;
    printf("\nEnter Vehicle ID (Number): ");
    scanf("%d", &newId);
    getchar();

    for (i = 0; i < vehicleCount; i++) {
        if (vehicleId[i] == newId) {
            printf("Error: Vehicle ID %d already exists!\n", newId);
            return;
        }
    }

    vehicleId[vehicleCount] = newId;

    printf("Enter Vehicle Name: ");
    fgets(vehicleName[vehicleCount], sizeof(vehicleName[vehicleCount]), stdin);
    removeNewLine(vehicleName[vehicleCount]);

    printf("Enter Vehicle Category: ");
    fgets(vehicleCategory[vehicleCount], sizeof(vehicleCategory[vehicleCount]), stdin);
    removeNewLine(vehicleCategory[vehicleCount]);

    printf("Enter Daily Rental Rate (Tk): ");
    scanf("%f", &rentalRate[vehicleCount]);
    getchar();

    available[vehicleCount] = 1;

    vehicleCount++;
    printf("\nVehicle Added Successfully!\n");
}

void viewAllVehicles() {
    int i;

    if (vehicleCount == 0) {
        printf("\nNo vehicles added to the system yet!\n");
        return;
    }

    printf("\n------------------------------------------------------------------------\n");
    printf("%-10s %-25s %-15s %-15s %-10s\n", "ID", "Name", "Category", "Rate/Day (Tk)", "Status");
    printf("------------------------------------------------------------------------\n");

    for (i = 0; i < vehicleCount; i++) {
        printf("%-10d %-25s %-15s %-15.2f %-10s\n",
               vehicleId[i],
               vehicleName[i],
               vehicleCategory[i],
               rentalRate[i],
               (available[i] == 1) ? "Available" : "Rented");
    }
    printf("------------------------------------------------------------------------\n");
}

void searchVehicleByName() {
    if (vehicleCount == 0) {
        printf("\nNo vehicles added to the system yet!\n");
        return;
    }

    char searchName[50], lowerSearch[50], lowerVehicle[50];
    int i, found = 0;

    printf("\nEnter Vehicle Name to search: ");
    fgets(searchName, sizeof(searchName), stdin);
    removeNewLine(searchName);
    toLowerCase(searchName, lowerSearch);

    printf("\n------------------------------------------------------------------------\n");
    printf("%-10s %-25s %-15s %-15s %-10s\n", "ID", "Name", "Category", "Rate/Day (Tk)", "Status");
    printf("------------------------------------------------------------------------\n");

    for (i = 0; i < vehicleCount; i++) {
        toLowerCase(vehicleName[i], lowerVehicle);
        if (strstr(lowerVehicle, lowerSearch) != NULL) {
            printf("%-10d %-25s %-15s %-15.2f %-10s\n",
                   vehicleId[i],
                   vehicleName[i],
                   vehicleCategory[i],
                   rentalRate[i],
                   (available[i] == 1) ? "Available" : "Rented");
            found = 1;
        }
    }
    printf("------------------------------------------------------------------------\n");

    if (found == 0) {
        printf("\nNo vehicle found matching: '%s'\n", searchName);
    }
}

void updateVehicle() {
    if (vehicleCount == 0) {
        printf("\nNo vehicles to update!\n");
        return;
    }

    char inputStr[50];
    printf("\nEnter Vehicle ID or Name to update: ");
    fgets(inputStr, sizeof(inputStr), stdin);
    removeNewLine(inputStr);

    int index = findVehicleByIdOrName(inputStr);

    if (index != -1) {
        printf("\nUpdating vehicle: %s (ID: %d)\n", vehicleName[index], vehicleId[index]);

        printf("Enter New Category: ");
        fgets(vehicleCategory[index], sizeof(vehicleCategory[index]), stdin);
        removeNewLine(vehicleCategory[index]);

        printf("Enter New Daily Rental Rate (Tk): ");
        scanf("%f", &rentalRate[index]);
        getchar();

        printf("\nVehicle information updated successfully!\n");
    } else {
        printf("\nVehicle not found!\n");
    }
}

void removeVehicle() {
    if (vehicleCount == 0) {
        printf("\nNo vehicles available to remove!\n");
        return;
    }

    char inputStr[50];
    int j;

    printf("\nEnter Vehicle ID or Name to remove: ");
    fgets(inputStr, sizeof(inputStr), stdin);
    removeNewLine(inputStr);

    int index = findVehicleByIdOrName(inputStr);

    if (index != -1) {
        for (j = index; j < vehicleCount - 1; j++) {
            vehicleId[j] = vehicleId[j + 1];
            strcpy(vehicleName[j], vehicleName[j + 1]);
            strcpy(vehicleCategory[j], vehicleCategory[j + 1]);
            rentalRate[j] = rentalRate[j + 1];
            available[j] = available[j + 1];
        }

        vehicleCount--;
        printf("\nVehicle removed successfully!\n");
    } else {
        printf("\nVehicle not found!\n");
    }
}

void viewRentalRecords() {
    int i;

    if (recordCount == 0) {
        printf("\nNo rental history recorded yet!\n");
        return;
    }

    printf("\n--------------------------------------------------\n");
    printf("%-10s %-15s %-15s %-10s\n", "Record #", "Vehicle ID", "Days Rented", "Total (Tk)");
    printf("--------------------------------------------------\n");

    for (i = 0; i < recordCount; i++) {
        printf("%-10d %-15d %-15d %-10.2f\n",
               i + 1,
               recordVehicleId[i],
               recordDays[i],
               recordTotalCost[i]);
    }
    printf("--------------------------------------------------\n");
}

void viewAvailableVehicles() {
    int i, foundAvailable = 0;

    if (vehicleCount == 0) {
        printf("\nNo vehicles added in the system yet!\n");
        return;
    }

    printf("\n------------------------------------------------------------------------\n");
    printf("%-10s %-25s %-15s %-15s\n", "ID", "Name", "Category", "Rate/Day (Tk)");
    printf("------------------------------------------------------------------------\n");

    for (i = 0; i < vehicleCount; i++) {
        if (available[i] == 1) {
            printf("%-10d %-25s %-15s %-15.2f\n",
                   vehicleId[i],
                   vehicleName[i],
                   vehicleCategory[i],
                   rentalRate[i]);
            foundAvailable = 1;
        }
    }
    printf("------------------------------------------------------------------------\n");

    if (foundAvailable == 0) {
        printf("\nSorry, no vehicles are currently available for rent.\n");
    }
}

void rentVehicle() {
    if (vehicleCount == 0) {
        printf("\nNo vehicles available in system!\n");
        return;
    }

    char inputStr[50];
    int days;
    float total;

    printf("\nEnter Vehicle ID or Name you want to rent: ");
    fgets(inputStr, sizeof(inputStr), stdin);
    removeNewLine(inputStr);

    int index = findVehicleByIdOrName(inputStr);

    if (index != -1) {
        if (available[index] == 0) {
            printf("\nSorry, this vehicle is already rented out!\n");
            return;
        }

        printf("Enter number of rental days: ");
        scanf("%d", &days);
        getchar();

        if (days <= 0) {
            printf("Invalid number of days!\n");
            return;
        }

        total = rentalRate[index] * days;

        printf("\n--- RENTAL RECEIPT SUMMARY ---\n");
        printf("Vehicle ID   : %d\n", vehicleId[index]);
        printf("Vehicle Name : %s\n", vehicleName[index]);
        printf("Daily Rate   : Tk %.2f\n", rentalRate[index]);
        printf("Days Rented  : %d\n", days);
        printf("Total Cost   : Tk %.2f\n", total);
        printf("------------------------------\n");

        available[index] = 0;

        recordVehicleId[recordCount] = vehicleId[index];
        recordDays[recordCount] = days;
        recordTotalCost[recordCount] = total;
        recordCount++;

        printf("\nBooking Confirmed! Enjoy your ride.\n");
    } else {
        printf("\nVehicle not found!\n");
    }
}

void returnVehicle() {
    if (vehicleCount == 0) {
        printf("\nNo vehicles in the system!\n");
        return;
    }

    char inputStr[50];
    printf("\nEnter Vehicle ID or Name to return: ");
    fgets(inputStr, sizeof(inputStr), stdin);
    removeNewLine(inputStr);

    int index = findVehicleByIdOrName(inputStr);

    if (index != -1) {
        if (available[index] == 1) {
            printf("\nThis vehicle is already marked as available!\n");
            return;
        }

        available[index] = 1;
        printf("\nVehicle '%s' (ID: %d) returned successfully!\n", vehicleName[index], vehicleId[index]);
    } else {
        printf("\nVehicle not found!\n");
    }
}
